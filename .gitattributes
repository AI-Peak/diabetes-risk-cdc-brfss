# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.joblib binary
*.npz binary
*.zip binary
*.ico binary

# Approved manuscript bytes are verified by final_source_manifest.json.
paper/** -text
